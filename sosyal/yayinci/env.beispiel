# Kopie nach sosyal/yayinci/.env (gitignored) und ausfüllen. yukle.sh installiert sie als /etc/praxura-sosyal/sosyal.env (root:sosyal 0640).
# Anleitung, woher die Werte kommen: sosyal/yayinci/KURULUM.md

# Meta — ein Page-Token (aus dem System-User-Token abgeleitet, läuft nicht ab)
META_PAGE_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=
META_API_VERSION=v23.0

# Telegram — eigener Bot nur für Praxura Social (nicht den gkv-Monitor-Bot wiederverwenden)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Zeitplan (Europe/Berlin)
SENDEZEIT=12:15
VORSCHAUZEIT=19:00
PLATTFORMEN=instagram,facebook
VORRAT_WARNUNG_TAGE=7
# Erster Sendetag (JJJJ-MM-TT, optional): Tage davor werden nie automatisch gepostet — /jetzt geht trotzdem
START_AB=
