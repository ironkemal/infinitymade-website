# ═══════════════════════════════════════════════════════════════════════════
#  Praxura On-Premise — Konfiguration der Kundenbox
# ═══════════════════════════════════════════════════════════════════════════
#
#  Vorlage. Beim Einrichten wird daraus `.env` erzeugt; die Geheimnisse
#  darin werden AUF DEM KUNDENSERVER gewuerfelt, nicht hier eingetragen und
#  nicht von uns vergeben (Leitplanke G2: kein Schluessel im Image, im Paket
#  oder im Git-Baum).
#
#  ⛔ `.env` gehoert NIE in dieses Repository. Siehe .gitignore.
#
# ═══════════════════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────────────────
#  1) VERSIONEN — der ganze Stack als EIN Artefakt
# ───────────────────────────────────────────────────────────────────────────
#  Die Compose-Datei traegt keine Tags. Sie stehen hier, damit ein Update
#  spaeter Zeilen in dieser Datei ersetzen kann, statt die Compose-Datei
#  auszutauschen (Register O-45, Loesungsteil a).
#
#  Diese Kombination ist am 10./11.09.2026 zusammen getestet worden:
#  leere Datenbank → Baseline eingespielt → Anmeldung, Profilanlage, Storage
#  und Realtime geprueft. Einzelne Zeilen NICHT unabhaengig voneinander
#  hochziehen — die Zahlen gehoeren zusammen.

VERSION_POSTGRES=17.6.1.136
VERSION_GOTRUE=v2.189.0
VERSION_POSTGREST=v14.12
VERSION_REALTIME=v2.102.3
VERSION_STORAGE=v1.60.4
VERSION_KONG=3.9.1

# Unser eigenes Backend-Image. Einziges Image, das Watchtower erneuern darf.
#
# Kanaele (O-148, 02.10.2026): `:beta` = jede Veroeffentlichung, `:stable` =
# erst nach 72 h Testbetrieb (promote-stable.yml). install.sh fragt den Kanal
# und schreibt ihn in die .env — HIER bleibt bewusst `:stable` stehen: stuende
# `:beta` in der Vorlage, zoege update.sh's .env-Zusammenfuehrung jede
# stable-Box still auf beta. GHCR-Images sind oeffentlich, keine Anmeldung.
PRAXURA_API_IMAGE=ghcr.io/ironkemal/infinitymade-website/calendar-api:stable

# Oberflaeche + Caddy, EIN Image (onprem/frontend.Dockerfile). Gleicher
# `:stable`-Vorbehalt wie oben: der Kanal ist beschlossen (Playbook K7),
# der Publish-Workflow baut ihn heute noch nicht (O-25).
PRAXURA_FRONTEND_IMAGE=ghcr.io/ironkemal/infinitymade-website/frontend:stable


# ───────────────────────────────────────────────────────────────────────────
#  2) GEHEIMNISSE — beim Einrichten erzeugt, nie hier eingetragen
# ───────────────────────────────────────────────────────────────────────────
#  install.sh (Phase 2.1c) wuerfelt diese Werte auf dem Kundenserver und
#  schreibt sie in `.env`. Wer sie von Hand setzt: als HEX, nicht Base64
#  (`openssl rand -hex 24` o. ae.) — POSTGRES_PASSWORD landet in mehreren
#  postgres://user:PASSWORT@host-URIs (docker-compose.yml), und Base64s
#  '+'/'/' waeren dort URL-Sonderzeichen, die das Parsing gelegentlich
#  brechen. install.sh haelt sich deshalb konsequent an Hex.
#
#  ANON_KEY und SERVICE_ROLE_KEY sind JWTs, die mit JWT_SECRET signiert
#  werden — sie lassen sich nicht frei waehlen, sondern werden daraus
#  ABGELEITET. Der Anon-Key ist oeffentlich (er steht im Browser); der
#  Service-Role-Key darf die Box nie verlassen.

POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
SECRET_KEY_BASE=
REALTIME_DB_ENC_KEY=
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=

# Eigenes Passwort je Dienstrolle (guvenlik S-21, KHS K2.6) — install.sh
# wuerfelt sie, volumes/db/praxura-rollen.sql setzt sie in der Datenbank.
# Leer = Rueckfall auf POSTGRES_PASSWORD (Verhalten vor 0.2.0). supabase_admin
# (realtime, api) bleibt bewusst bei POSTGRES_PASSWORD.
PG_AUTHENTICATOR_PASSWORD=
PG_AUTH_ADMIN_PASSWORD=
PG_STORAGE_ADMIN_PASSWORD=

# ★ Verschluesselung der Patientenfelder (`icd10_enc`, `ocr_raw_enc`).
#   64 Hex-Zeichen: `openssl rand -hex 32`
#
#   Bleibt der Wert leer, verschluesselt die Box NICHT — und sagt es niemandem:
#   der Code prueft nur, ob die Variable da ist, und schreibt die Felder sonst
#   einfach nicht. Die Kundenbox staende damit schwaecher da als die Cloud.
#
#   ⚠️ Der Schluessel muss gesichert werden — aber GETRENNT von den Daten.
#   Geht er verloren, sind die verschluesselten Felder unlesbar, auch mit einem
#   vollstaendigen pg_dump. Liegt er dagegen im selben Sicherungssatz wie der
#   pg_dump, ist die Verschluesselung fuer jeden wertlos, der diese Sicherung
#   in die Hand bekommt. Also: eigener Ort (Ausdruck im Tresor, zweiter
#   Datentraeger), nicht der Backup-Ordner. (guvenlik S-22, 11.09.2026)
#
#   Rotation ist heute NICHT moeglich: der Chiffretext traegt keine
#   Schluesselkennung. Das muss vor der ersten ausgelieferten Box dazukommen.
DATA_ENCRYPTION_KEY=


# ───────────────────────────────────────────────────────────────────────────
#  3) ADRESSEN
# ───────────────────────────────────────────────────────────────────────────
#  So, wie die Box aus dem Praxisnetz erreichbar ist. Der Browser der
#  Mitarbeiter benutzt genau diese Adresse — steht hier etwas Falsches,
#  scheitert die Anmeldung mit einem CORS-Fehler, der wie ein Netzproblem
#  aussieht.
#
#  ⚠️ Seit O-01/O-15 (11.09.2026) ist SUPABASE_PUBLIC_URL/ANON_KEY auch das,
#  was GET /api/config an den Browser zurückgibt (api-backend/server.js).
#  Bleiben sie leer, liefert die Route eine leere supabaseUrl — die ganze
#  Oberfläche bleibt weiß, kein CORS-Fehler, keine Fehlermeldung (O-53).

SUPABASE_PUBLIC_URL=https://praxis.local
API_EXTERNAL_URL=https://praxis.local
SITE_URL=https://praxis.local
ADDITIONAL_REDIRECT_URLS=

# ★ Adresse des Praxura-Namensdienstes (K2b.2 / K2b.17, O-161).
#   Zwingend https://; wird ausschließlich über die Vorlage verteilt
#   (update.sh J4 Dreiwege-Merge) — install.sh schreibt diesen Wert NICHT.
#   Leer = Einrichtung ohne Code (eigene Adresse / lokaler Hostname,
#   Ausstiegsweg K2b.8). Keine ACME_DNS_URL — diese liefert Merkez in der
#   Antwort von /v1/register (server_url).
MERKEZ_URL=

# ★ TLS-Modus für Caddy (K2b.4, O-161 / O-171).
#   acmedns   = Box mit Einrichtungscode, DNS-01 über den Praxura-Namensdienst.
#               Wird von install.sh nur auf dem Code-Weg gesetzt, nachdem
#               acmedns.json in der Box nachgewiesen ist.
#   klassisch = CADDY_TLS_ARG gilt (internal oder E-Mail).
#   Ausstiegsweg (KURULUM.md §8) = klassisch.
CADDY_TLS_MODUS=klassisch

# ★ Caddy (Faz 2.1b, 11.09.2026). Gilt bei CADDY_TLS_MODUS=klassisch.
# "internal" = Caddys eigene, selbstsignierte CA — kein Internetzugriff noetig,
# der Normalfall fuer die erste Box im Praxisnetz. Fuer ein echtes
# Let's-Encrypt-Zertifikat per HTTP-01: die E-Mail-Adresse eintragen, die ACME
# bei Problemen benachrichtigt — SITE_URL muss dann eine ECHTE, von aussen
# erreichbare Domain sein, nicht "praxis.local".
CADDY_TLS_ARG=internal

# HSTS-Dauer: 0 bei internal (selbstsigniert), 86400 (1 Tag) bei acmedns (bis
# Ablaufüberwachung existiert, O-172, S-47 Bedingung 5), 63072000 (2 Jahre) bei
# klassisch mit E-Mail (wie SaaS). Vorher sperrt der Browser den Host sonst
# fest auf HTTPS, und der Rückweg liegt beim Kunden, nicht bei uns (O-52).
HSTS_MAX_AGE=0

# Nur setzen, wenn SUPABASE_PUBLIC_URL NICHT derselbe Origin wie SITE_URL ist
# (Sonderfall — Normalfall ist EIN Origin fuer alles, siehe oben). Sonst leer
# lassen: 'self' im CSP deckt das eigene wss:// bereits ab.
SUPABASE_PUBLIC_WSS=

# Innerhalb des Docker-Netzes. Nicht anfassen.
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
KONG_HTTP_PORT=8000


# ───────────────────────────────────────────────────────────────────────────
#  4) ANMELDUNG UND E-MAIL
# ───────────────────────────────────────────────────────────────────────────
#  Konten entstehen in der Box OHNE Mail (O-142, Entscheidung 01.10.2026):
#  Inhaber ueber den Einrichtungsassistenten, Mitarbeiter ueber einen
#  Einrichtungscode vom Inhaber, vergessenes Inhaber-Passwort mit
#  `sudo bash reset-owner-passwort.sh` am Server. GoTrue bekommt deshalb
#  KEINEN Mailserver, install.sh fragt nicht danach.
#
#  OPTIONAL — nur fuer Mails an Patienten (Terminbestaetigung, Termin-Anfrage,
#  Mahnung, verschickt vom `api`-Container): den Mailserver des KUNDEN hier
#  eintragen, dann 'docker compose up -d api'. Absender auf der eigenen Domain
#  der Praxis, sonst weisen SPF/DMARC die Mails ab (Register O-51). Leer =
#  diese Mails entfallen still; alles andere laeuft.
#  (SMTP_FROM leer = alter SaaS-Fallback `noreply@praxura.de`,
#  api-backend/lib/mail.js — auf SaaS unveraendert.)

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Anzeigename der Express-Mails. Leer = wie bisher "<Praxisname> via Praxura"
# (aus dem Owner-Profil). Gesetzt = genau dieser Name, ohne "via Praxura".
MAIL_FROM_NAME=

# In der Box legt der Inhaber die Mitarbeiter an; niemand registriert sich
# selbst. Bleibt IMMER "true" — auch waehrend der Ersteinrichtung (O-62,
# 11.09.2026 korrigiert: "kurz auf false" haette das Praxisnetz fuer die
# Dauer der Einrichtung fuer JEDEN offen registrierbar gemacht). Der erste
# Owner entsteht ueber GoTrues Admin-Endpunkt (Einrichtungsassistent, Phase
# 2.2, per SETUP_TOKEN unten geschuetzt) — DISABLE_SIGNUP steht dem nicht im Weg.
DISABLE_SIGNUP=true
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false

JWT_EXPIRY=3600


# ───────────────────────────────────────────────────────────────────────────
#  5) DATEIEN UND POSTGREST
# ───────────────────────────────────────────────────────────────────────────

GLOBAL_S3_BUCKET=stub
STORAGE_TENANT_ID=praxura
REGION=local

PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public,extensions


# ───────────────────────────────────────────────────────────────────────────
#  6) KI — Schluessel des Kunden (K4, BYO-Key) · Vertrag mit M4 (O-151)
# ───────────────────────────────────────────────────────────────────────────
#  AI_MODE=aus ist der Normalfall der Box: die Anwendung startet vollstaendig,
#  KI-Funktionen (Rezept-Scan, Mail-Entwurf, Serienplanung) antworten mit einer
#  deutschen Meldung statt zu arbeiten. `direkt` = mit dem EIGENEN Schluessel
#  der Praxis direkt zum Anbieter. Ein zentraler KI-Vermittler ist verboten
#  (K6) — ginge das Rezeptbild durch uns, faenden wir uns in §393 SGB V wieder.
#  install.sh fragt hier NICHTS ab (K-3: erste Box ohne KI).

AI_MODE=aus
AI_PROVIDER=
AI_ENDPOINT=
AI_API_KEY=
AI_MODEL_TEXT=
AI_MODEL_VISION=

TZ=Europe/Berlin


# ───────────────────────────────────────────────────────────────────────────
#  7) EINRICHTUNGS-JETON — von install.sh erzeugt, nicht von Hand setzen
# ───────────────────────────────────────────────────────────────────────────
#  Einmalig, schuetzt den Einrichtungsassistenten (Phase 2.2): ohne dieses
#  Jeton legt niemand den ersten Owner an. Verhindert "wer zuerst im
#  Praxisnetz auf die Box zugreift, wird Inhaber" (O-62). Wird nach dem
#  ersten Owner vom Assistenten selbst geloescht/entwertet.
SETUP_TOKEN=


# ───────────────────────────────────────────────────────────────────────────
#  8) YEDEKLEME (O-26) — install.sh sorar, boş = kutu içi + uyarı
# ───────────────────────────────────────────────────────────────────────────
#  Boş bırakılırsa yedekler kutunun kendi diskinde kalır ($SCRIPT_DIR/backups) —
#  disk arızasında veritabanıyla BİRLİKTE kaybolurlar (onprem/RELEASE-STANDARD.md
#  §6.6). Gerçek koruma için mount edilmiş bir dizin yolu (NAS/SMB/NFS, önceden
#  müşteri tarafından bağlanmış) girilmeli. SSH/rsync hedefi bu sürümde YOK
#  (onprem/REGISTER.md O-26'nın kendi maddesi — ayrı bir tur, kendi O-numarası).
BACKUP_ZIEL=
