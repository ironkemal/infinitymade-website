# ═══════════════════════════════════════════════════════════════════════════
#  Praxura On-Premise — Konfiguration der Kundenbox
# ═══════════════════════════════════════════════════════════════════════════
#
#  Vorlage. Beim Einrichten wird daraus `.env` erzeugt; die Geheimnisse
#  darin werden AUF DEM KUNDENSERVER gewuerfelt, nicht hier eingetragen und
#  nicht von uns vergeben (Leitplanke G2: kein Schluessel im Image, im Paket
#  oder im Git-Baum).
#
#  ⛔ `.env` gehoert NIE in dieses Repository. Siehe .gitignore.
#
# ═══════════════════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────────────────
#  1) VERSIONEN — der ganze Stack als EIN Artefakt
# ───────────────────────────────────────────────────────────────────────────
#  Die Compose-Datei traegt keine Tags. Sie stehen hier, damit ein Update
#  spaeter Zeilen in dieser Datei ersetzen kann, statt die Compose-Datei
#  auszutauschen (Register O-45, Loesungsteil a).
#
#  Diese Kombination ist am 10./11.09.2026 zusammen getestet worden:
#  leere Datenbank → Baseline eingespielt → Anmeldung, Profilanlage, Storage
#  und Realtime geprueft. Einzelne Zeilen NICHT unabhaengig voneinander
#  hochziehen — die Zahlen gehoeren zusammen.

VERSION_POSTGRES=17.6.1.136
VERSION_GOTRUE=v2.189.0
VERSION_POSTGREST=v14.12
VERSION_REALTIME=v2.102.3
VERSION_STORAGE=v1.60.4
VERSION_KONG=3.9.1

# Unser eigenes Backend-Image. Einziges Image, das Watchtower erneuern darf.
#
# ⛔ ACHTUNG — DIESER TAG EXISTIERT HEUTE NOCH NICHT.
# Die Veroeffentlichung baut nur `latest` und einen Kurz-SHA
# (.github/workflows/publish-calendar-api.yml:65). Die Kanaele `:stable` und
# `:beta` aus Playbook K7 sind beschlossen, aber nicht gebaut — ein
# `docker compose up` auf einem Kundenserver bekaeme hier ein leeres Regal.
# Ausserdem fehlt in dieser Vorlage die Anmeldung an der Registry (Phase 3.4).
#
# Diese Datei beschreibt also den Zielzustand, nicht den heutigen. Solange das
# so ist, ist das Paket eine lauffaehige Testumgebung — kein installierbares
# Produkt. Aufzuloesen in Phase 4.3b (Kanal-Tags) und 3.4 (Registry-Zugang).
PRAXURA_API_IMAGE=ghcr.io/ironkemal/infinitymade-website/calendar-api:stable


# ───────────────────────────────────────────────────────────────────────────
#  2) GEHEIMNISSE — beim Einrichten erzeugt, nie hier eingetragen
# ───────────────────────────────────────────────────────────────────────────
#  install.sh (Phase 2.1c) wuerfelt diese Werte auf dem Kundenserver und
#  schreibt sie in `.env`. Wer sie von Hand setzt: mindestens 32 Zeichen,
#  aus einer echten Zufallsquelle (`openssl rand -base64 48`).
#
#  ANON_KEY und SERVICE_ROLE_KEY sind JWTs, die mit JWT_SECRET signiert
#  werden — sie lassen sich nicht frei waehlen, sondern werden daraus
#  ABGELEITET. Der Anon-Key ist oeffentlich (er steht im Browser); der
#  Service-Role-Key darf die Box nie verlassen.

POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
SECRET_KEY_BASE=
REALTIME_DB_ENC_KEY=
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=

# ★ Verschluesselung der Patientenfelder (`icd10_enc`, `ocr_raw_enc`).
#   64 Hex-Zeichen: `openssl rand -hex 32`
#
#   Bleibt der Wert leer, verschluesselt die Box NICHT — und sagt es niemandem:
#   der Code prueft nur, ob die Variable da ist, und schreibt die Felder sonst
#   einfach nicht. Die Kundenbox staende damit schwaecher da als die Cloud.
#
#   ⚠️ Dieser Schluessel gehoert IN DIE SICHERUNG. Geht er verloren, sind die
#   verschluesselten Felder unlesbar — auch mit einem vollstaendigen pg_dump.
DATA_ENCRYPTION_KEY=


# ───────────────────────────────────────────────────────────────────────────
#  3) ADRESSEN
# ───────────────────────────────────────────────────────────────────────────
#  So, wie die Box aus dem Praxisnetz erreichbar ist. Der Browser der
#  Mitarbeiter benutzt genau diese Adresse — steht hier etwas Falsches,
#  scheitert die Anmeldung mit einem CORS-Fehler, der wie ein Netzproblem
#  aussieht.

SUPABASE_PUBLIC_URL=https://praxis.local
API_EXTERNAL_URL=https://praxis.local
SITE_URL=https://praxis.local
ADDITIONAL_REDIRECT_URLS=

# Innerhalb des Docker-Netzes. Nicht anfassen.
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
KONG_HTTP_PORT=8000


# ───────────────────────────────────────────────────────────────────────────
#  4) ANMELDUNG UND E-MAIL
# ───────────────────────────────────────────────────────────────────────────
#  Der SMTP-Server ist der des KUNDEN. Die Box schickt Einladungen und
#  Passwort-Resets darueber — nicht ueber uns (Leitplanke G1: die Box
#  telefoniert nicht zu uns).
#
#  ⚠️ ZWEI Absender benutzen denselben Server: GoTrue verschickt Einladung und
#  Passwort-Reset, unser Express verschickt Terminbestaetigung, Termin-Anfrage
#  und Mahnung. Beide lesen dieselben Variablen. Wer nur einem davon SMTP gibt,
#  bekommt den taeuschendsten aller Zustaende: die Anmeldemails kommen an, also
#  wirkt der Mailversand in Ordnung, waehrend die Terminmails stumm verfallen.
#
#  ⚠️ Die Absenderadresse der Express-Mails steht heute FEST im Code
#  (`noreply@praxura.de`). Ueber den Mailserver des Kunden verschickt, weisen
#  SPF/DMARC das bei den meisten Anbietern ab. Hier ist nichts einzustellen,
#  weil es nichts einzustellen gibt — offener Punkt im Register.
#
#  Fehlt SMTP ganz, laeuft alles weiter, aber niemand bekommt eine Einladung.
#  Der Einrichtungsassistent muss das pruefen und benennen.

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=Praxura

# In der Box legt der Inhaber die Mitarbeiter an; niemand registriert sich
# selbst. Waehrend der Ersteinrichtung kurz "false", danach "true".
DISABLE_SIGNUP=true
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false

JWT_EXPIRY=3600
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify


# ───────────────────────────────────────────────────────────────────────────
#  5) DATEIEN UND POSTGREST
# ───────────────────────────────────────────────────────────────────────────

GLOBAL_S3_BUCKET=stub
STORAGE_TENANT_ID=praxura
REGION=local

PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public,extensions


# ───────────────────────────────────────────────────────────────────────────
#  6) KI — Schluessel des Kunden (K4, BYO-Key)
# ───────────────────────────────────────────────────────────────────────────
#  Leer lassen ist erlaubt und der Normalfall: dann startet die Anwendung
#  vollstaendig, nur die Rezepterkennung bleibt still. Ein zentraler
#  KI-Vermittler ist verboten (K6) — ginge das Rezeptbild durch uns, faenden
#  wir uns wieder in §393 SGB V wieder.

AI_PROVIDER=
AI_ENDPOINT=
AI_API_KEY=

TZ=Europe/Berlin
