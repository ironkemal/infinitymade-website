#!/bin/sh
# Depo hook'ları. Kurulum (her geliştirici bir kez):
#   git config core.hooksPath .githooks

repo_root=$(git rev-parse --show-toplevel)

sh "$repo_root/tools/check-dashboard-size.sh" || exit 1
sh "$repo_root/tools/check-namen.sh" || exit 1
sh "$repo_root/tools/check-secrets.sh" || exit 1
sh "$repo_root/tools/check-syntax.sh" || exit 1
sh "$repo_root/tools/check-tabellen-register.sh" || exit 1
sh "$repo_root/tools/check-select-spalten.sh" || exit 1
sh "$repo_root/tools/check-onprem.sh" || exit 1
sh "$repo_root/tools/check-onprem-volumes.sh" || exit 1
sh "$repo_root/tools/check-security-definer-grants.sh" || exit 1
sh "$repo_root/tools/check-anon-grants.sh" || exit 1
sh "$repo_root/tools/check-tanimsiz.sh" || exit 1

# Kapi degil, uretici: fonksiyon haritasini tazeleyip commit'e ekler (hep 0 doner).
sh "$repo_root/tools/harita-tazele.sh"

exit 0
